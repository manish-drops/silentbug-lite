{
  "schema_version": 1,
  "patterns": [
    {
      "kind": "anthropic_key",
      "regex": "sk-ant-[A-Za-z0-9_\\-]{20,}",
      "prefix": "sk-ant-"
    },
    {
      "kind": "openai_key",
      "regex": "sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_\\-]{20,}",
      "prefix": "sk-"
    },
    {
      "kind": "aws_access_key",
      "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "prefix": "AKIA"
    },
    {
      "kind": "github_token",
      "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b",
      "prefix": "gh"
    },
    {
      "kind": "github_pat",
      "regex": "\\bgithub_pat_[A-Za-z0-9_]{22,}\\b",
      "prefix": "github_pat_"
    },
    {
      "kind": "slack_token",
      "regex": "\\bxox[baprs]-[A-Za-z0-9\\-]{10,}\\b",
      "prefix": "xox"
    },
    {
      "kind": "stripe_key",
      "regex": "\\b(?:sk|rk)_live_[A-Za-z0-9]{16,}\\b",
      "prefix": "sk_live_"
    },
    {
      "kind": "google_api_key",
      "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
      "prefix": "AIza"
    },
    {
      "kind": "huggingface_token",
      "regex": "\\bhf_[A-Za-z0-9]{30,}\\b",
      "prefix": "hf_"
    },
    {
      "kind": "sendgrid_key",
      "regex": "\\bSG\\.[A-Za-z0-9_\\-]{16,}\\.[A-Za-z0-9_\\-]{16,}\\b",
      "prefix": "SG."
    },
    {
      "kind": "jwt",
      "regex": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}",
      "prefix": "eyJ"
    },
    {
      "kind": "private_key",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?(?:-----END [A-Z ]*PRIVATE KEY-----|$)",
      "prefix": ""
    },
    {
      "kind": "url_credentials",
      "regex": "\\b[a-z][a-z0-9+.\\-]*://[^/\\s:@'\"]+:([^/\\s@'\"]{4,})@",
      "prefix": "",
      "group": 1
    },
    {
      "kind": "assigned_secret",
      "regex": "(?i)\\b[A-Za-z0-9_]*(?:api[_\\-]?key|secret|token|passw(?:or)?d|pwd|access[_\\-]?key|client[_\\-]?secret|private[_\\-]?key|auth[_\\-]?key)[A-Za-z0-9_]*[\"']?\\s*(?:=|:|:=)\\s*[\"']([^\"'\\s]{8,})[\"']",
      "prefix": "",
      "group": 1,
      "min_entropy": 2.5
    },
    {
      "kind": "env_secret",
      "regex": "(?im)^\\s*(?:export\\s+)?[A-Za-z0-9_]*(?:KEY|SECRET|TOKEN|PASSWORD|PASSWD|PWD)[A-Za-z0-9_]*\\s*=\\s*[\"']?([^\"'\\s#]{8,})",
      "prefix": "",
      "group": 1,
      "min_entropy": 2.5
    }
  ],
  "placeholders": [
    "your",
    "example",
    "xxxx",
    "changeme",
    "change_me",
    "placeholder",
    "dummy",
    "fake",
    "sample",
    "redacted",
    "<",
    ">",
    "${",
    "{{",
    "****",
    "process.env",
    "os.environ",
    "os.getenv",
    "insert",
    "replace",
    "todo",
    "none",
    "null",
    "secret_here",
    "key_here",
    "here",
    "test_key",
    "testkey",
    "notreal",
    "not-a-real",
    "…",
    "...",
    "env(",
    "changethis"
  ],
  "high_entropy": {
    "min_length": 20,
    "min_entropy": 4.0
  },
  "default_passwords": [
    "guest",
    "postgres",
    "password",
    "root",
    "admin",
    "test",
    "dev",
    "example",
    "changethis",
    "mysql",
    "redis",
    "rabbitmq",
    "minioadmin",
    "pass",
    "user"
  ]
}
